# =============================================================================
# Backend Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.
# All variables have sensible defaults - you only need to set what you want to change.
# =============================================================================

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# CORS allowed origins (JSON array format)
# For local Docker setup, the default works out of the box
ALLOW_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# -----------------------------------------------------------------------------
# Ollama Connection
# -----------------------------------------------------------------------------

# Ollama server URL
# Use http://localhost:11434 for local development
# Use http://ollama:11434 when running in Docker Compose
OLLAMA_BASE_URL=http://localhost:11434

# Model to use (must be available on the Ollama server)
OLLAMA_MODEL=qwen2.5:7b-instruct

# -----------------------------------------------------------------------------
# LLM Generation Parameters
# -----------------------------------------------------------------------------

# Sampling temperature (0.0 = deterministic, higher = more creative)
OLLAMA_TEMPERATURE=0.2

# Nucleus sampling threshold (0.0 to 1.0)
OLLAMA_TOP_P=0.9

# Top-k sampling limit
OLLAMA_TOP_K=40

# Repetition penalty factor (1.0 = no penalty)
OLLAMA_REPEAT_PENALTY=1.1

# Context window size (input tokens)
OLLAMA_NUM_CTX=4096

# Maximum tokens to generate per response
OLLAMA_NUM_PREDICT=512

# -----------------------------------------------------------------------------
# Advanced Parameters (Optional - uncomment to use)
# -----------------------------------------------------------------------------

# Deterministic seed for reproducible outputs
# OLLAMA_SEED=42

# Stop sequences (JSON array format)
# OLLAMA_STOP=["</s>", "[DONE]"]

# Mirostat sampling mode (0 = disabled, 1 or 2 = enabled)
# OLLAMA_MIROSTAT=0

# Mirostat target surprise parameter
# OLLAMA_MIROSTAT_TAU=5.0

# Mirostat learning rate parameter
# OLLAMA_MIROSTAT_ETA=0.1
